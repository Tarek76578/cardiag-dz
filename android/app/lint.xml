<!--
  CarDiag DZ lint configuration.

  We intentionally keep lint warnings visible. This file only disables
  checks that produce confirmed false positives in the current
  codebase. New regressions in production code remain reported.

  - GradleDependency: dependency upgrades are tracked separately and
    must not block CI; a stale advisory should not delay a green
    build.
  - Typos: the lint dictionary flags "Exemple" (French for "Example")
    which is intentional copy in the French UI strings.
  - UnusedAttribute: android:usesPermissionFlags="neverForLocation" is
    a forward-compat declaration (API 31+); lint flags it because
    minSdk=26 but the attribute is only consumed on API 31+ devices.
    The manifest merger copies this attribute into the final manifest
    for API 31+ devices, satisfying the Play Store BLUETOOTH_SCAN
    location-derivation policy without affecting older devices.
-->
<lint>
    <issue id="GradleDependency" severity="informational" />
    <issue id="Typos" severity="informational" />
    <issue id="UnusedAttribute" severity="informational" />
