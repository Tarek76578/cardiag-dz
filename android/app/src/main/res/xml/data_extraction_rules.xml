<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data extraction rules for CarDiag DZ.
  Backup is disabled in the manifest, so both cloud backup and
  device-to-device transfer must explicitly exclude every storage
  location that could contain authenticated user data.
  CarDiag stores Supabase auth tokens, vehicle profiles (including
  VIN), OBD scan results and diagnostic history in the app-private
  directories. None of this may leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
